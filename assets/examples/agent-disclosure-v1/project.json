    },
    {
      "id": "level2",
      "title": "第二层：正文",
      "cues": [
        {
          "id": "level2",
          "spoken_text": "比如你说：把这份 PDF 转成表格。Agent 对着简介一扫，只有 PDF 这一项对上，这时才把它的完整说明读进来。",
          "subtitle": "只有对上的那一项 才读入完整说明",
          "action_s": 5.0,
          "hold_s": 0.6,
          "audio": "audio/level2-my-voice-lively-6115d48bcd27.wav",
          "seed": 1238
        }
      ]
    },
