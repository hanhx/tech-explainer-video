    {
      "id": "recap",
      "title": "像查一本厚书",
      "start_s": 67.76666666666667,
      "duration_s": 15.166666666666666,
      "lead_s": 0.0,
      "tail_s": 0.8,
      "cues": [
        {
          "id": "recap",
          "spoken_text": "就像查一本厚书：先看目录，再翻到那一章，最后才查附录。所以写技能时，简介要写清什么时候用，细节放进正文和文件。",
          "subtitle": "简介写清何时用 细节放进正文和文件",
