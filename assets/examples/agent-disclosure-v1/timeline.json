      "title": "问题被淹没",
      "start_s": 8.466666666666667,
      "duration_s": 8.766666666666667,
      "lead_s": 0.0,
      "tail_s": 0.0,
      "cues": [
        {
          "id": "pain",
          "spoken_text": "窗口瞬间被挤满。你真正的问题，反而没地方放了，又贵又慢，还容易答偏。",
          "subtitle": "窗口被挤满 真正的问题反而没地方放",
          "start_s": 0.0,
          "absolute_start_s": 8.46666667,
          "duration_s": 8.24,
          "action_s": 3.0,
          "hold_s": 0.5,
